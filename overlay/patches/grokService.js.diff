+function isShortUserCode(s) {
+  const t = String(s || "");
+  if (!t || t.length > 17) return false;
+  if (/[._]/.test(t)) return false;
+  return /^[A-Z0-9]{4,8}(?:-[A-Z0-9]{4,8})?$/i.test(t);
+}
+
+function isDeviceAuthPageUrl(href) {
+  const t = String(href || "").trim();
+  if (!/^https:\/\//i.test(t)) return false;
+  const lower = t.toLowerCase();
+  if (lower.includes("/oauth2/device/code") || lower.includes("/oauth2/token")) return false;
+  return (
+    lower.includes("://grok.com/") ||
+    lower.includes("://www.grok.com/") ||
+    lower.includes("://accounts.x.ai/oauth2/device")
+  );
+}
+
+/** Keep in sync with overlay/fixtures/parse-device-auth.js */
+function parseDeviceAuth(text) {
+  const raw = String(text || "");
+  let url = null;
+  const urlMatch = raw.match(/https:\/\/[^\s"'<>\\]+/i);
+  if (urlMatch) {
+    const cand = urlMatch[0].replace(/[.,;:!?)\]>]+$/g, "");
+    if (isDeviceAuthPageUrl(cand)) url = cand;
+  }
+
+  let userCode = null;
+  const labeled = raw.match(
+    /(?:user[\s_-]*code|enter(?:\s+the)?\s+code|code)\s*[:=]?\s*([A-Z0-9]{4,8}(?:-[A-Z0-9]{4,8})?)/i
+  );
+  if (labeled && isShortUserCode(labeled[1])) {
+    userCode = labeled[1].toUpperCase();
+  }
+  if (!userCode) {
+    const hyphen = raw.match(/\b([A-Z0-9]{4,8}-[A-Z0-9]{4,8})\b/i);
+    if (hyphen && isShortUserCode(hyphen[1])) {
+      userCode = hyphen[1].toUpperCase();
+    }
+  }
+  if (!url && !userCode) return null;
+  if (userCode && !url) url = "https://grok.com/device";
+  return { url: url || null, userCode: userCode || null };
+}
+
+function redactLoginChunk(chunk) {
+  let text = String(chunk || "");
+  text = text.replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9._-]+\b/g, "[redacted-jwt]");
+  text = text.replace(
+    /\b(access_token|refresh_token|device_code|id_token)\s*[:=]\s*\S+/gi,
+    (_, name) => `${name}=[redacted]`
+  );
+  text = text.replace(/\b[A-Za-z0-9_-]{40,}\b/g, "[redacted]");
+  return text;
+}
+
+function appendLoginDebug(chunk) {
+  const text = redactLoginChunk(chunk);
+  if (!text) return;
+  try {
+    const dir = path.join(os.homedir(), ".grok-desktop");
+    fs.mkdirSync(dir, { recursive: true });
+    fs.appendFileSync(path.join(dir, "debug.log"), text, "utf8");
+  } catch {
+    /* ignore */
+  }
+}
+
+function readDebugTail(maxBytes) {
+  const n = maxBytes || 4096;
+  try {
+    const p = path.join(os.homedir(), ".grok-desktop", "debug.log");
+    if (!fs.existsSync(p)) return "";
+    const st = fs.statSync(p);
+    const start = Math.max(0, st.size - n);
+    const fd = fs.openSync(p, "r");
+    try {
+      const len = st.size - start;
+      const buf = Buffer.alloc(len);
+      fs.readSync(fd, buf, 0, len, start);
+      return buf.toString("utf8");
+    } finally {
+      fs.closeSync(fd);
+    }
+  } catch {
+    return "";
+  }
+}
