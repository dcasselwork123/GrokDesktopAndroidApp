+function questDirBytes(root) {
+  let total = 0;
+  let n = 0;
+  function walk(dir) {
+    if (total >= 8 * 1024 * 1024 * 1024 || n > 20000) return;
+    let ents;
+    try {
+      ents = fs.readdirSync(dir, { withFileTypes: true });
+    } catch {
+      return;
+    }
+    for (const ent of ents) {
+      if (total >= 8 * 1024 * 1024 * 1024 || n > 20000) return;
+      n += 1;
+      const p = path.join(dir, ent.name);
+      try {
+        if (ent.isDirectory()) walk(p);
+        else if (ent.isFile()) total += fs.statSync(p).size;
+      } catch {
+        /* skip */
+      }
+    }
+  }
+  if (root) walk(root);
+  return total;
+}
+
+function questDiskInfo() {
+  if (!process.env.GROK_QUEST_WORKSPACE) return null;
+  const disk = { freeBytes: null, grokHomeBytes: null };
+  try {
+    const st = fs.statfsSync(process.env.HOME || process.cwd());
+    disk.freeBytes = Number(st.bavail) * Number(st.bsize);
+  } catch {
+    /* missing statfs */
+  }
+  try {
+    const home = process.env.GROK_HOME || path.join(process.env.HOME || "", ".grok");
+    disk.grokHomeBytes = questDirBytes(home);
+  } catch {
+    /* skip */
+  }
+  return disk;
+}
